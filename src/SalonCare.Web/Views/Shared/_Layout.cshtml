<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SalonCare CRM</title>
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }
        .navbar-brand-custom {
            font-weight: 700;
            background: linear-gradient(135deg, #0d6efd, #0dcaf0);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .card-custom {
            border: 1px solid rgba(226, 232, 240, 0.8);
            border-radius: 1rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
            background: #ffffff;
        }
        .kpi-card {
            border-radius: 0.85rem;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .kpi-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(0,0,0,0.07);
        }
        .badge-status-confirmed { background-color: #198754; color: #fff; }
        .badge-status-pending { background-color: #ffc107; color: #000; }
        .badge-status-completed { background-color: #0d6efd; color: #fff; }
        .badge-status-noshow { background-color: #dc3545; color: #fff; }
        .badge-status-canceled { background-color: #6c757d; color: #fff; }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm sticky-top">
            <div class="container-fluid px-4">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Appointments" asp-action="Index">
                    <span class="p-2 bg-primary bg-opacity-10 rounded-3 text-primary">
                        <i class="bi bi-calendar2-check-fill fs-4"></i>
                    </span>
                    <div>
                        <span class="navbar-brand-custom fs-4">SalonCare</span>
                        <span class="badge bg-primary-subtle text-primary ms-1">W02/W03</span>
                        <div class="small text-muted" style="font-size: 0.7rem;">Hệ thống CRM Spa/Salon & Chống No-Show</div>
                    </div>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link active fw-semibold text-primary" asp-controller="Appointments" asp-action="Index">
                                <i class="bi bi-calendar-event me-1"></i> Quản lý Lịch hẹn
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-secondary" href="#rfmSection">
                                <i class="bi bi-people me-1"></i> Phân khúc RFM
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-secondary" href="#znsSection">
                                <i class="bi bi-chat-dots me-1"></i> Tích hợp Zalo ZNS
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-3">
                        <div class="d-none d-md-block text-end">
                            <div class="fw-bold small text-dark">Hoàng Khắc Trung Hiếu</div>
                            <div class="text-muted" style="font-size: 0.75rem;">MSSV: 2380600645 • Lớp: 23DTHC7</div>
                        </div>
                        <div class="avatar bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px;">
                            TH
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1 py-4">
        <div class="container-fluid px-4">
            @RenderBody()
        </div>
    </main>

    <footer class="bg-white border-top py-3 mt-auto">
        <div class="container-fluid px-4 d-flex flex-column flex-md-row justify-content-between align-items-center text-muted small">
            <div>
                <strong>SalonCare CRM</strong> - Đồ án Chuyên ngành Công nghệ Thông tin (Học kỳ 1 / 2026)
            </div>
            <div class="mt-2 mt-md-0">
                Tác giả: <strong>Hoàng Khắc Trung Hiếu (2380600645)</strong> | GVHD: <strong>TS. Nguyễn Quang Trung</strong>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
