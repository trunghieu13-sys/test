@model SalonCare.Web.Models.AppointmentIndexViewModel
@{
    ViewData["Title"] = "Quản lý Lịch hẹn & Chống Trùng giờ KTV";
}

<!-- BANNER GIỚI THIỆU ĐỒ ÁN W02/W03 -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card border-0 text-white rounded-4 shadow-sm" style="background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);">
            <div class="card-body p-4 p-md-5">
                <div class="row align-items-center">
                    <div class="col-lg-8">
                        <span class="badge bg-light text-primary px-3 py-2 rounded-pill fw-bold mb-2">
                            <i class="bi bi-shield-check me-1"></i> BÁO CÁO TIẾN ĐỘ TUẦN 03 (W02/W03)
                        </span>
                        <h2 class="fw-bold mb-2">Hệ thống SalonCare CRM - Xếp lịch hẹn thông minh</h2>
                        <p class="mb-0 text-white-50 fs-6">
                            Đồ án: <em>"Hệ thống CRM quản lý Spa/Salon nhỏ giảm tỉ lệ bỏ hẹn (No-show) dựa trên phân khúc RFM"</em><br />
                            Sinh viên: <strong>Hoàng Khắc Trung Hiếu</strong> (MSSV: <strong>2380600645</strong> - Lớp: <strong>23DTHC7</strong>) | GVHD: <strong>TS. Nguyễn Quang Trung</strong>
                        </p>
                    </div>
                    <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                        <div class="d-inline-flex flex-column align-items-lg-end gap-1">
                            <span class="badge bg-white text-dark py-2 px-3 rounded-3 shadow-sm text-start">
                                <i class="bi bi-clock-history text-primary me-1"></i> Giờ làm việc: 06:00 - 16:00 (6h - 16h)
                            </span>
                            <span class="badge bg-white text-dark py-2 px-3 rounded-3 shadow-sm text-start">
                                <i class="bi bi-cpu-fill text-success me-1"></i> Tự động tính Slot Rảnh / Bận
                            </span>
                            <span class="badge bg-white text-dark py-2 px-3 rounded-3 shadow-sm text-start">
                                <i class="bi bi-shield-lock-fill text-danger me-1"></i> Chống Overlap KTV cấp CSDL
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- KHỐI THÔNG BÁO ALERT (TEMP DATA) -->
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 border-start border-danger border-5" role="alert">
        <div class="d-flex align-items-center">
            <i class="bi bi-exclamation-triangle-fill fs-3 me-3 text-danger"></i>
            <div>
                <strong class="fs-6 d-block">CẢNH BÁO XUNG ĐỘT THỜI GIAN:</strong>
                <span>@TempData["ErrorMessage"]</span>
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 border-start border-success border-5" role="alert">
        <div class="d-flex align-items-center">
            <i class="bi bi-check-circle-fill fs-3 me-3 text-success"></i>
            <div>
                <strong class="fs-6 d-block">THAO TÁC THÀNH CÔNG:</strong>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- KHỐI THỐNG KÊ NHANH (KPI CARDS) -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card kpi-card border-0 bg-white shadow-sm p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Tổng số lịch hẹn</span>
                    <h3 class="fw-bold mb-0 mt-1 text-primary">@Model.TotalAppointments</h3>
                </div>
                <div class="bg-primary-subtle text-primary p-3 rounded-3">
                    <i class="bi bi-calendar3 fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card kpi-card border-0 bg-white shadow-sm p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Đã xác nhận</span>
                    <h3 class="fw-bold mb-0 mt-1 text-success">@Model.ConfirmedCount</h3>
                </div>
                <div class="bg-success-subtle text-success p-3 rounded-3">
                    <i class="bi bi-patch-check-fill fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card kpi-card border-0 bg-white shadow-sm p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">Chờ xử lý</span>
                    <h3 class="fw-bold mb-0 mt-1 text-warning">@Model.PendingCount</h3>
                </div>
                <div class="bg-warning-subtle text-warning p-3 rounded-3">
                    <i class="bi bi-hourglass-split fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card kpi-card border-0 bg-white shadow-sm p-3">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted small fw-semibold text-uppercase">No-Show (Bỏ hẹn)</span>
                    <h3 class="fw-bold mb-0 mt-1 text-danger">@Model.NoShowCount</h3>
                </div>
                <div class="bg-danger-subtle text-danger p-3 rounded-3">
                    <i class="bi bi-person-x-fill fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- KHU VỰC CHÍNH: FORM ĐẶT LỊCH (BÊN TRÁI) VÀ DANH SÁCH LỊCH HẸN (BÊN PHẢI) -->
<div class="row g-4">
    <!-- CỘT TRÁI: FORM ĐẶT LỊCH HẸN MỚI -->
    <div class="col-lg-5">
        <div class="card card-custom h-100">
            <div class="card-header bg-white border-bottom py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-plus-circle-fill text-primary me-2"></i>Đặt Lịch Hẹn Mới
                        </h5>
                        <small class="text-muted">Ca làm việc: <strong>06:00 - 16:00</strong> (6h sáng - 4h chiều)</small>
                    </div>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Ca: 6h - 16h</span>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-controller="Appointments" asp-action="Create" method="post" id="appointmentForm">
                    @Html.AntiForgeryToken()

                    <!-- Chọn Khách hàng -->
                    <div class="mb-3">
                        <label for="CustomerId" class="form-label fw-semibold small">
                            <i class="bi bi-person me-1"></i> Khách hàng <span class="text-danger">*</span>
                        </label>
                        <select name="CustomerId" id="CustomerId" class="form-select form-select-sm fs-6" required>
                            <option value="">-- Chọn khách hàng --</option>
                            @foreach (var cust in Model.Customers)
                            {
                                <option value="@cust.CustomerId" selected="@(cust.CustomerId == 1 ? "selected" : null)">@cust.FullName - @cust.PhoneNumber</option>
                            }
                        </select>
                    </div>

                    <!-- Chọn Kỹ thuật viên & Ngày hẹn (2 cột ngang) -->
                    <div class="row g-2 mb-3">
                        <div class="col-md-7">
                            <label for="TechnicianId" class="form-label fw-semibold small">
                                <i class="bi bi-scissors me-1"></i> Kỹ thuật viên (Thợ) <span class="text-danger">*</span>
                            </label>
                            <select name="TechnicianId" id="TechnicianId" class="form-select form-select-sm fs-6" required onchange="loadSchedule()">
                                @foreach (var tech in Model.Technicians)
                                {
                                    <option value="@tech.TechnicianId" selected="@(tech.TechnicianId == 1 ? "selected" : null)">@tech.FullName (@tech.Specialization)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-5">
                            <label for="AppointmentDate" class="form-label fw-semibold small">
                                <i class="bi bi-calendar-date me-1"></i> Ngày hẹn <span class="text-danger">*</span>
                            </label>
                            <input name="AppointmentDate" id="AppointmentDate" type="date" class="form-control form-control-sm fs-6" value="2026-11-02" required onchange="loadSchedule()" />
                        </div>
                    </div>

                    <!-- KHU VỰC NÚT ĐỎ (KHUNG GIỜ ĐÃ ĐẶT) -->
                    <div class="mb-3 p-3 rounded-3 bg-danger bg-opacity-10 border border-danger border-opacity-25">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="fw-bold text-danger small">
                                <i class="bi bi-x-octagon-fill me-1"></i> KHUNG GIỜ ĐÃ ĐẶT (NÚT ĐỎ - BẬN):
                            </span>
                            <span class="badge bg-danger text-white" id="busyCountBadge">0 đã đặt</span>
                        </div>
                        <div id="busySlotsContainer" class="d-flex flex-wrap gap-2">
                            <span class="text-muted small fst-italic">Đang tải lịch KTV...</span>
                        </div>
                        <div class="text-muted small mt-2" style="font-size: 0.75rem;">
                            <i class="bi bi-info-circle me-1"></i> <em>Click vào nút đỏ để tự động điền giờ trùng và xem cảnh báo chặn.</em>
                        </div>
                    </div>

                    <!-- KHU VỰC NÚT XANH (KHUNG GIỜ RẢNH CÒN LẠI TRONG CA 6h - 16h) -->
                    <div class="mb-3 p-3 rounded-3 bg-success bg-opacity-10 border border-success border-opacity-25">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="fw-bold text-success small">
                                <i class="bi bi-check-circle-fill me-1"></i> KHUNG GIỜ CÒN RẢNH (NÚT XANH - 06:00 -> 16:00):
                            </span>
                            <span class="badge bg-success text-white" id="freeCountBadge">0 rảnh</span>
                        </div>
                        <div id="freeSlotsContainer" class="d-flex flex-wrap gap-2">
                            <span class="text-muted small fst-italic">Đang tính toán giờ rảnh...</span>
                        </div>
                        <div class="text-muted small mt-2" style="font-size: 0.75rem;">
                            <i class="bi bi-hand-index-thumb me-1"></i> <em>Click vào nút xanh bất kỳ để tự động chọn giờ rảnh và đặt lịch thành công!</em>
                        </div>
                    </div>

                    <!-- Khung giờ đã chọn (Bắt đầu - Kết thúc) -->
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label for="StartTime" class="form-label fw-semibold small">Giờ Bắt Đầu <span class="text-danger">*</span></label>
                            <input name="StartTime" id="StartTime" type="time" class="form-control" value="06:00" required />
                        </div>
                        <div class="col-6">
                            <label for="EndTime" class="form-label fw-semibold small">Giờ Kết Thúc <span class="text-danger">*</span></label>
                            <input name="EndTime" id="EndTime" type="time" class="form-control" value="07:00" required />
                        </div>
                    </div>

                    <!-- Tên Dịch vụ & Đơn giá -->
                    <div class="row g-2 mb-3">
                        <div class="col-7">
                            <label for="ServiceName" class="form-label fw-semibold small">Gói Dịch vụ <span class="text-danger">*</span></label>
                            <input name="ServiceName" id="ServiceName" class="form-control form-control-sm" value="Cắt uốn tạo kiểu cao cấp" required />
                        </div>
                        <div class="col-5">
                            <label for="Price" class="form-label fw-semibold small">Đơn giá (VNĐ) <span class="text-danger">*</span></label>
                            <input name="Price" id="Price" type="number" step="10000" class="form-control form-control-sm" value="250000" required />
                        </div>
                    </div>

                    <!-- Ghi chú -->
                    <div class="mb-4">
                        <label for="Notes" class="form-label fw-semibold small">Ghi chú yêu cầu</label>
                        <input name="Notes" id="Notes" class="form-control form-control-sm" placeholder="Yêu cầu riêng của khách..." />
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-lg fw-semibold shadow-sm">
                            <i class="bi bi-calendar-plus me-1"></i> Xác nhận Đặt Lịch
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- CỘT PHẢI: BẢNG DANH SÁCH LỊCH HẸN -->
    <div class="col-lg-7">
        <div class="card card-custom h-100">
            <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-card-checklist text-primary me-2"></i>Danh Sách Lịch Hẹn Đã Xếp
                    </h5>
                    <small class="text-muted">Theo dõi và quản lý lịch phục vụ của salon</small>
                </div>
                <div>
                    <span class="badge bg-secondary-subtle text-secondary px-3 py-2 rounded-pill">
                        <i class="bi bi-list-check me-1"></i> @Model.Appointments.Count() Lịch hẹn
                    </span>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-secondary small text-uppercase">
                            <tr>
                                <th class="ps-3">Mã</th>
                                <th>Khách Hàng</th>
                                <th>Kỹ Thuật Viên</th>
                                <th>Dịch Vụ & Giá</th>
                                <th>Ngày & Giờ</th>
                                <th>Trạng Thái</th>
                                <th class="text-center pe-3">Hủy</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Appointments.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                        Chưa có lịch hẹn nào trong hệ thống.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model.Appointments)
                                {
                                    <tr>
                                        <td class="ps-3 fw-bold text-muted">#@item.AppointmentId</td>
                                        <td>
                                            <div class="fw-bold text-dark">@(item.Customer?.FullName ?? "N/A")</div>
                                            <div class="small text-muted" style="font-size:0.75rem;">
                                                @(item.Customer?.PhoneNumber ?? "---")
                                            </div>
                                        </td>
                                        <td>
                                            <div class="fw-semibold text-primary">@(item.Technician?.FullName ?? "N/A")</div>
                                        </td>
                                        <td>
                                            <div class="fw-bold small">@item.ServiceName</div>
                                            <div class="small text-success fw-semibold">@item.Price.ToString("N0") đ</div>
                                        </td>
                                        <td>
                                            <div class="fw-bold small text-dark">
                                                @item.AppointmentDate.ToString("dd/MM/yyyy")
                                            </div>
                                            <div class="small text-muted">
                                                <strong>@item.StartTime.ToString("HH:mm")</strong> - <strong>@item.EndTime.ToString("HH:mm")</strong>
                                            </div>
                                        </td>
                                        <td>
                                            @switch (item.Status)
                                            {
                                                case AppointmentStatus.Confirmed:
                                                    <span class="badge badge-status-confirmed px-2 py-1 rounded-pill small">
                                                        <i class="bi bi-check-circle me-1"></i>Đã xác nhận
                                                    </span>
                                                    break;
                                                case AppointmentStatus.Pending:
                                                    <span class="badge badge-status-pending px-2 py-1 rounded-pill small">
                                                        <i class="bi bi-hourglass me-1"></i>Chờ xác nhận
                                                    </span>
                                                    break;
                                                case AppointmentStatus.Completed:
                                                    <span class="badge badge-status-completed px-2 py-1 rounded-pill small">
                                                        <i class="bi bi-award me-1"></i>Hoàn thành
                                                    </span>
                                                    break;
                                                case AppointmentStatus.NoShow:
                                                    <span class="badge badge-status-noshow px-2 py-1 rounded-pill small">
                                                        <i class="bi bi-x-octagon me-1"></i>No-Show
                                                    </span>
                                                    break;
                                                case AppointmentStatus.Canceled:
                                                    <span class="badge badge-status-canceled px-2 py-1 rounded-pill small">
                                                        <i class="bi bi-slash-circle me-1"></i>Đã hủy
                                                    </span>
                                                    break;
                                            }
                                        </td>
                                        <td class="text-center pe-3">
                                            <form asp-controller="Appointments" asp-action="Delete" asp-route-id="@item.AppointmentId" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa lịch hẹn #@item.AppointmentId?');" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle p-1" style="width:28px;height:28px;" title="Xóa lịch hẹn">
                                                    <i class="bi bi-trash-fill"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-white border-top py-3 px-4 d-flex justify-content-between align-items-center">
                <span class="text-muted small">Khung giờ hoạt động: <code>06:00 - 16:00</code></span>
                <span class="badge bg-light text-dark border">Thuật toán trừ khoảng thời gian bận</span>
            </div>
        </div>
    </div>
</div>

<script>
    // Điền giờ vào ô input StartTime và EndTime khi click nút đỏ hoặc nút xanh
    function selectSlot(start, end, isBusy) {
        document.getElementById('StartTime').value = start;
        document.getElementById('EndTime').value = end;

        // Hiệu ứng nhấp nháy nhẹ ở 2 ô input để người dùng biết đã được chọn
        const startInput = document.getElementById('StartTime');
        const endInput = document.getElementById('EndTime');
        startInput.classList.add('bg-warning', 'bg-opacity-25');
        endInput.classList.add('bg-warning', 'bg-opacity-25');
        setTimeout(() => {
            startInput.classList.remove('bg-warning', 'bg-opacity-25');
            endInput.classList.remove('bg-warning', 'bg-opacity-25');
        }, 300);
    }

    // Tự động tải lịch ĐÃ ĐẶT (nút đỏ) và GIỜ RẢNH (nút xanh) từ 06:00 đến 16:00
    async function loadSchedule() {
        const techId = document.getElementById('TechnicianId').value;
        const date = document.getElementById('AppointmentDate').value;
        const busyContainer = document.getElementById('busySlotsContainer');
        const freeContainer = document.getElementById('freeSlotsContainer');
        const busyBadge = document.getElementById('busyCountBadge');
        const freeBadge = document.getElementById('freeCountBadge');

        if (!techId || !date) return;

        busyContainer.innerHTML = '<span class="text-muted small fst-italic"><span class="spinner-border spinner-border-sm me-1"></span> Đang tải...</span>';
        freeContainer.innerHTML = '<span class="text-muted small fst-italic"><span class="spinner-border spinner-border-sm me-1"></span> Đang tính toán...</span>';

        try {
            const response = await fetch(`/Appointments/GetSchedule?technicianId=${techId}&date=${date}`);
            const data = await response.json();

            // 1. RENDER NÚT ĐỎ (KHUNG GIỜ ĐÃ ĐẶT)
            busyContainer.innerHTML = '';
            busyBadge.textContent = `${data.busySlots.length} đã đặt`;

            if (data.busySlots.length === 0) {
                busyContainer.innerHTML = '<span class="text-muted small fst-italic"><i class="bi bi-info-circle me-1"></i> Chưa có khách nào đặt lịch trong ngày này (KTV hoàn toàn rảnh cả ca).</span>';
            } else {
                data.busySlots.forEach(slot => {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'btn btn-danger btn-sm rounded-pill fw-semibold shadow-sm text-nowrap';
                    btn.innerHTML = `<i class="bi bi-x-circle-fill me-1"></i> ${slot.label}`;
                    btn.title = `Đã đặt bởi ${slot.customer} (${slot.service}). Bấm để thử test chặn trùng lịch!`;
                    btn.onclick = () => selectSlot(slot.start, slot.end, true);
                    busyContainer.appendChild(btn);
                });
            }

            // 2. RENDER NÚT XANH (KHUNG GIỜ CÒN RẢNH TRONG CA 06:00 - 16:00)
            freeContainer.innerHTML = '';
            freeBadge.textContent = `${data.freeSlots.length} slot rảnh`;

            if (data.freeSlots.length === 0) {
                freeContainer.innerHTML = '<span class="text-danger small fw-semibold"><i class="bi bi-exclamation-triangle-fill me-1"></i> Toàn bộ các khung giờ trong ca làm việc (06:00 - 16:00) đã kín lịch!</span>';
            } else {
                data.freeSlots.forEach(slot => {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = 'btn btn-outline-success btn-sm rounded-pill fw-semibold shadow-sm text-nowrap';
                    btn.innerHTML = `<i class="bi bi-check-circle me-1"></i> ${slot.label}`;
                    btn.title = `Khung giờ rảnh (${slot.label}). Bấm để chọn và đặt lịch thành công!`;
                    btn.onclick = () => selectSlot(slot.start, slot.end, false);
                    freeContainer.appendChild(btn);
                });

                // Tự động gán slot rảnh đầu tiên vào form nếu chưa có
                if (data.freeSlots.length > 0) {
                    const currentStart = document.getElementById('StartTime').value;
                    const isCurrentBusy = data.busySlots.some(b => b.start === currentStart);
                    if (isCurrentBusy || !currentStart) {
                        selectSlot(data.freeSlots[0].start, data.freeSlots[0].end, false);
                    }
                }
            }
        } catch (error) {
            console.error('Lỗi khi tải lịch:', error);
            busyContainer.innerHTML = '<span class="text-danger small">Lỗi kết nối tải lịch.</span>';
            freeContainer.innerHTML = '<span class="text-danger small">Lỗi kết nối tải lịch.</span>';
        }
    }

    // Tự động chạy khi tải trang
    document.addEventListener('DOMContentLoaded', function () {
        loadSchedule();
    });
</script>
